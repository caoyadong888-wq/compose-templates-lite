# Copy to .env to override. Defaults match the compose file.
# Change POSTGRES_PASSWORD before you put this on a shared network.

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=app
POSTGRES_PORT=5432

# The sidecar dumps once at start, then every BACKUP_INTERVAL_SECONDS.
# Files older than BACKUP_RETENTION_DAYS are deleted.
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400
